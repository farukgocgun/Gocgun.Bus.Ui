<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Gocgun.Bus.Ui</RootNamespace>
    <AssemblyName>gocgun-bus-ui</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>Gocgun.Bus.Ui</PackageId>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <Description>Read-only RabbitMQ diagnostic UI for protobuf bus messages.</Description>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gocgun.Bus.Ui.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Gocgun.Diagnostics.Shared\Gocgun.Diagnostics.Shared.csproj" />
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
